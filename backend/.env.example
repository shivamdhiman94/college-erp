# ==============================================================================
# Quantum University ERP System — Backend Environment Configuration Template
# ==============================================================================

# Application Runtime
PROJECT_NAME="Quantum University ERP API"
ENVIRONMENT="development"  # Options: development, staging, production
DEBUG=True
API_V1_STR="/api/v1"

# Security & Cryptography
# Generate a secure 32+ character random string for production:
# Linux/macOS: openssl rand -hex 32
# Windows PowerShell: [Convert]::ToHexString((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
SECRET_KEY="college-erp-super-secret-production-quality-jwt-signing-key-32-chars-min"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# Database Configurations
# ------------------------------------------------------------------------------
# Option A: Local SQLite (Zero-config local development and testing)
DATABASE_URL="sqlite:///./college_erp.db"

# Option B: Cloud PostgreSQL (Managed AWS RDS / Supabase / Neon / Cloud SQL)
# DATABASE_URL="postgresql+psycopg2://<db_user>:<db_password>@<db_host>:5432/<db_name>?sslmode=require"

# Database Connection Pooling (PostgreSQL Only)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=False

# ------------------------------------------------------------------------------
# CORS Allowed Origins (Comma-separated or JSON array)
# ------------------------------------------------------------------------------
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
# For production domains:
# BACKEND_CORS_ORIGINS=["https://erp.quantum.edu", "https://app.quantum.edu"]

# ------------------------------------------------------------------------------
# Initial Bootstrap Superadmin
# ------------------------------------------------------------------------------
FIRST_SUPERADMIN_EMAIL="shivam@quantum.edu"
FIRST_SUPERADMIN_USERNAME="shivam"
FIRST_SUPERADMIN_PASSWORD="shivam@123"
